From 930026090f2824d9e80b6deb6cbdfe830c3c671d Mon Sep 17 00:00:00 2001
From: Mikhail-Nevskiy <noreply@github.com>
Date: Wed, 21 Oct 2026 23:24:46 +0300
Subject: [PATCH 3/3] ipa: simple: Add a tuning file for the OV9760

The uncalibrated algorithms without the colour correction matrix, which
is too slow on the MT6589's Cortex-A7 cores untuned.
---
 src/ipa/simple/data/meson.build |  1 +
 src/ipa/simple/data/ov9760.yaml | 10 ++++++++++
 2 files changed, 11 insertions(+)
 create mode 100644 src/ipa/simple/data/ov9760.yaml

diff --git a/src/ipa/simple/data/meson.build b/src/ipa/simple/data/meson.build
index 92795ee..f178477 100644
--- a/src/ipa/simple/data/meson.build
+++ b/src/ipa/simple/data/meson.build
@@ -1,6 +1,7 @@
 # SPDX-License-Identifier: CC0-1.0
 
 conf_files = files([
+    'ov9760.yaml',
     'uncalibrated.yaml',
 ])
 
diff --git a/src/ipa/simple/data/ov9760.yaml b/src/ipa/simple/data/ov9760.yaml
new file mode 100644
index 0000000..99b05a2
--- /dev/null
+++ b/src/ipa/simple/data/ov9760.yaml
@@ -0,0 +1,10 @@
+# SPDX-License-Identifier: CC0-1.0
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+  - Awb:
+  - Adjust:
+  - Agc:
+...
-- 
2.43.0

